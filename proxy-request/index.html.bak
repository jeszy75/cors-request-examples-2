<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Codes</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">
</head>

<body class="bg-body-secondary">

    <main class="container py-5">
        <h1 class="display-5 fw-semibold text-center mb-5">
            Country Codes
        </h1>

        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Country Code</th>
                        <th scope="col">Country Name</th>
                    </tr>
                </thead>
                <tbody id="countries">
                </tbody>
            </table>
        </div>
    </main>

    <script>
        const countriesTableBody = document.getElementById("countries");

        fetch("https://proxy.cors.dev/https://country.io/names.json")
            .then(response => {
                if (!response.ok) {
                    throw new Error(
                        `HTTP error: ${response.status} ${response.statusText}`
                    );
                }

                return response.json();
            })
            .then(data => {
                Object.entries(data).forEach(([code, name]) => {
                    const row = document.createElement("tr");

                    row.innerHTML = `
                        <td>${code}</td>
                        <td>${name}</td>
                    `;

                    countriesTableBody.appendChild(row);
                });
            })
            .catch(error => {
                console.error("Failed to load countries:", error);
            });
    </script>

</body>
</html>
